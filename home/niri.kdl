// Runtime-generated settings stay writable while the main config remains managed by Home Manager.
// Noctalia writes colors to noctalia.kdl; nwg-displays writes outputs to monitor.kdl.
// default.nix pre-creates both files so these includes also work on the first login.
include "noctalia.kdl"
include "monitor.kdl"

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 600
        repeat-rate 25
    }

    // External mouse uses flat acceleration profile, matching Hyprland's global flat profile.
    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    // Touchpad settings reference hyprland.lua's touchpad configuration.
    touchpad {
        tap
        dwt
        natural-scroll
        click-method "clickfinger"
        scroll-method "two-finger"
        scroll-factor 0.5
        accel-profile "adaptive"
        accel-speed 0.0
    }

    // Do not let pointer focus unexpectedly scroll a long horizontal strip.
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    // Keep only the focus ring; its colors are overridden by noctalia.kdl.
    focus-ring {
        width 2
    }
    border {
        off
    }
}

// Match Hyprland's four-pass background blur while keeping colors neutral.
blur {
    passes 4
    offset 3
    noise 0.02
    saturation 1.0
}

// Noctalia requests compositor blur for its layer surfaces even when the bar
// background is fully transparent. Disable it only for the bar; application
// blur and Noctalia panels remain unchanged.
layer-rule {
    match namespace="^noctalia-bar-.+$"
    background-effect {
        blur false
    }
}

// Match Hyprland's 10px window rounding, including window contents.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Catppuccin glass effect, corresponding to window_rule in hyprland.lua.
window-rule {
    match app-id=r#"^(kitty|org\.kde\.dolphin)$"#
    opacity 0.90
    background-effect {
        // Reuse the blurred wallpaper for better performance and stability.
        xray true
        blur true
    }
}

// QQ uses one app-id for both windows; the title keeps the main window tiled.
window-rule {
    match app-id="^QQ$" title="^图片查看器$"
    open-floating true
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

environment {
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XMODIFIERS "@im=fcitx"
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "32"
}

binds {
    // ============================================================
    // #"窗口与会话 / Windows and session"
    // ============================================================
    Mod+Q repeat=false hotkey-overlay-title="关闭当前窗口 / Close window" { close-window; }
    Alt+F4 repeat=false hotkey-overlay-title="关闭当前窗口 / Close window" { close-window; }
    Mod+W repeat=false hotkey-overlay-title="切换窗口浮动 / Toggle floating" { toggle-window-floating; }
    Mod+Shift+V repeat=false hotkey-overlay-title="切换浮动窗口与平铺窗口焦点 / Focus floating or tiled window" { switch-focus-between-floating-and-tiling; }
    Mod+Shift+F repeat=false hotkey-overlay-title="切换窗口全屏 / Toggle fullscreen" { fullscreen-window; }
    Mod+F11 repeat=false hotkey-overlay-title="切换窗口全屏 / Toggle fullscreen" { fullscreen-window; }
    Mod+F repeat=false hotkey-overlay-title="切换窗口列最大宽度 / Toggle full-width column" { maximize-column; }
    Mod+M repeat=false hotkey-overlay-title="切换窗口最大化 / Toggle maximize" { maximize-window-to-edges; }
    Mod+Backslash repeat=false hotkey-overlay-title="切换窗口列标签页模式 / Toggle tabbed column" { toggle-column-tabbed-display; }

    // Let Noctalia own the lock screen, and do not allow
    // shortcut-inhibiting clients to swallow the binding.
    Mod+Alt+L repeat=false allow-when-locked=true allow-inhibiting=false hotkey-overlay-title="锁定屏幕 / Lock screen" {
        spawn "noctalia" "msg" "session" "lock";
    }

    // Native niri recent-windows owns Alt+Tab. Super+Tab remains a quick
    // workspace back-and-forth shortcut.
    Mod+Tab repeat=false hotkey-overlay-title="切换到上次工作区 / Previous workspace" { focus-workspace-previous; }

    // Escape hatch for remote desktop, games, and other shortcut inhibitors.
    Mod+Escape repeat=false allow-inhibiting=false hotkey-overlay-title="切换应用独占快捷键 / Toggle shortcut inhibition" { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E repeat=false hotkey-overlay-title="退出 niri 会话 / Quit niri session" { quit; }

    // ============================================================
    // #"焦点与浮动窗口移动 / Focus and floating windows"
    // Arrow keys intelligently move floating windows or focus tiled windows
    // ============================================================
    Mod+Left hotkey-overlay-title="向左移动浮动窗口或切换平铺焦点 / Move floating or focus left" { spawn "niri-smart-direction" "move" "left"; }
    Mod+Right hotkey-overlay-title="向右移动浮动窗口或切换平铺焦点 / Move floating or focus right" { spawn "niri-smart-direction" "move" "right"; }
    Mod+Up hotkey-overlay-title="向上移动浮动窗口或切换平铺焦点 / Move floating or focus up" { spawn "niri-smart-direction" "move" "up"; }
    Mod+Down hotkey-overlay-title="向下移动浮动窗口或切换平铺焦点 / Move floating or focus down" { spawn "niri-smart-direction" "move" "down"; }
    Mod+H hotkey-overlay-title="切换到左侧窗口列 / Focus left column" { focus-column-left; }
    Mod+L hotkey-overlay-title="切换到右侧窗口列 / Focus right column" { focus-column-right; }
    Mod+K hotkey-overlay-title="切换到上方窗口 / Focus window above" { focus-window-up; }
    Mod+J hotkey-overlay-title="切换到下方窗口 / Focus window below" { focus-window-down; }

    // ============================================================
    // #"移动窗口与窗口列 / Moving windows and columns"
    // ============================================================
    Mod+Ctrl+Left hotkey-overlay-title="向左移动窗口列 / Move column left" { move-column-left; }
    Mod+Ctrl+Right hotkey-overlay-title="向右移动窗口列 / Move column right" { move-column-right; }
    Mod+Ctrl+Up hotkey-overlay-title="向上移动窗口 / Move window up" { move-window-up; }
    Mod+Ctrl+Down hotkey-overlay-title="向下移动窗口 / Move window down" { move-window-down; }
    Mod+Ctrl+H hotkey-overlay-title="向左移动窗口列 / Move column left" { move-column-left; }
    Mod+Ctrl+L hotkey-overlay-title="向右移动窗口列 / Move column right" { move-column-right; }
    Mod+Ctrl+K hotkey-overlay-title="向上移动窗口 / Move window up" { move-window-up; }
    Mod+Ctrl+J hotkey-overlay-title="向下移动窗口 / Move window down" { move-window-down; }

    // ============================================================
    // #"窗口大小与显示器 / Window size and displays"
    // Shift+arrow keys intelligently resize floating windows or focus monitors for tiled windows
    // ============================================================
    Mod+Shift+Left hotkey-overlay-title="浮动窗口缩小宽度或切换到左侧显示器 / Resize floating or focus display left" { spawn "niri-smart-direction" "resize" "left"; }
    Mod+Shift+Right hotkey-overlay-title="浮动窗口增大宽度或切换到右侧显示器 / Resize floating or focus display right" { spawn "niri-smart-direction" "resize" "right"; }
    Mod+Shift+Up hotkey-overlay-title="浮动窗口缩小高度或切换到上侧显示器 / Resize floating or focus display up" { spawn "niri-smart-direction" "resize" "up"; }
    Mod+Shift+Down hotkey-overlay-title="浮动窗口增大高度或切换到下侧显示器 / Resize floating or focus display down" { spawn "niri-smart-direction" "resize" "down"; }
    Mod+Shift+H hotkey-overlay-title="切换到左侧显示器 / Focus left display" { focus-monitor-left; }
    Mod+Shift+L hotkey-overlay-title="切换到右侧显示器 / Focus right display" { focus-monitor-right; }
    Mod+Shift+K hotkey-overlay-title="切换到上方显示器 / Focus display above" { focus-monitor-up; }
    Mod+Shift+J hotkey-overlay-title="切换到下方显示器 / Focus display below" { focus-monitor-down; }

    Mod+Ctrl+Shift+Left hotkey-overlay-title="移动窗口列到左侧显示器 / Move column to left display" { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right hotkey-overlay-title="移动窗口列到右侧显示器 / Move column to right display" { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up hotkey-overlay-title="移动窗口列到上方显示器 / Move column to display above" { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down hotkey-overlay-title="移动窗口列到下方显示器 / Move column to display below" { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+H hotkey-overlay-title="移动窗口列到左侧显示器 / Move column to left display" { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L hotkey-overlay-title="移动窗口列到右侧显示器 / Move column to right display" { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+K hotkey-overlay-title="移动窗口列到上方显示器 / Move column to display above" { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+J hotkey-overlay-title="移动窗口列到下方显示器 / Move column to display below" { move-column-to-monitor-down; }

    // ============================================================
    // #"应用 / Applications"
    // ============================================================
    Mod+T repeat=false hotkey-overlay-title="打开终端 Kitty / Open terminal Kitty" { spawn "kitty"; }
    Mod+E repeat=false hotkey-overlay-title="打开文件管理器 Dolphin / Open file manager Dolphin" { spawn "dolphin"; }
    Mod+C repeat=false hotkey-overlay-title="打开编辑器 VS Code / Open editor VS Code" { spawn "code"; }
    Mod+B repeat=false hotkey-overlay-title="打开浏览器 Firefox / Open browser Firefox" { spawn "firefox"; }
    Ctrl+Shift+Escape repeat=false hotkey-overlay-title="打开系统监视器 / System monitor" {
        spawn "missioncenter";
    }
    Mod+A repeat=false hotkey-overlay-title="打开应用启动器 / Application launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }
    Mod+V repeat=false hotkey-overlay-title="打开剪贴板历史 / Clipboard history" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard";
    }

    // ============================================================
    // #"工作区 / Workspaces"
    // ============================================================
    // Numeric indices are best-effort in niri's dynamic workspace model: an
    // index past the current workspace count selects the trailing empty one.
    Mod+1 hotkey-overlay-title="切换到工作区 1 / Focus workspace 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="切换到工作区 2 / Focus workspace 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="切换到工作区 3 / Focus workspace 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="切换到工作区 4 / Focus workspace 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="切换到工作区 5 / Focus workspace 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="切换到工作区 6 / Focus workspace 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="切换到工作区 7 / Focus workspace 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="切换到工作区 8 / Focus workspace 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="切换到工作区 9 / Focus workspace 9" { focus-workspace 9; }
    Mod+0 hotkey-overlay-title="切换到工作区 10 / Focus workspace 10" { focus-workspace 10; }

    Mod+Shift+1 repeat=false hotkey-overlay-title="移动窗口列到工作区 1 / Move column to workspace 1" { move-column-to-workspace 1; }
    Mod+Shift+2 repeat=false hotkey-overlay-title="移动窗口列到工作区 2 / Move column to workspace 2" { move-column-to-workspace 2; }
    Mod+Shift+3 repeat=false hotkey-overlay-title="移动窗口列到工作区 3 / Move column to workspace 3" { move-column-to-workspace 3; }
    Mod+Shift+4 repeat=false hotkey-overlay-title="移动窗口列到工作区 4 / Move column to workspace 4" { move-column-to-workspace 4; }
    Mod+Shift+5 repeat=false hotkey-overlay-title="移动窗口列到工作区 5 / Move column to workspace 5" { move-column-to-workspace 5; }
    Mod+Shift+6 repeat=false hotkey-overlay-title="移动窗口列到工作区 6 / Move column to workspace 6" { move-column-to-workspace 6; }
    Mod+Shift+7 repeat=false hotkey-overlay-title="移动窗口列到工作区 7 / Move column to workspace 7" { move-column-to-workspace 7; }
    Mod+Shift+8 repeat=false hotkey-overlay-title="移动窗口列到工作区 8 / Move column to workspace 8" { move-column-to-workspace 8; }
    Mod+Shift+9 repeat=false hotkey-overlay-title="移动窗口列到工作区 9 / Move column to workspace 9" { move-column-to-workspace 9; }
    Mod+Shift+0 repeat=false hotkey-overlay-title="移动窗口列到工作区 10 / Move column to workspace 10" { move-column-to-workspace 10; }

    Mod+Page_Down hotkey-overlay-title="切换到下方工作区 / Focus workspace below" { focus-workspace-down; }
    Mod+Page_Up hotkey-overlay-title="切换到上方工作区 / Focus workspace above" { focus-workspace-up; }
    Mod+U hotkey-overlay-title="切换到下方工作区 / Focus workspace below" { focus-workspace-down; }
    Mod+I hotkey-overlay-title="切换到上方工作区 / Focus workspace above" { focus-workspace-up; }

    Mod+Ctrl+Page_Down hotkey-overlay-title="移动窗口列到下方工作区 / Move column to workspace below" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up hotkey-overlay-title="移动窗口列到上方工作区 / Move column to workspace above" { move-column-to-workspace-up; }
    Mod+Ctrl+U hotkey-overlay-title="移动窗口列到下方工作区 / Move column to workspace below" { move-column-to-workspace-down; }
    Mod+Ctrl+I hotkey-overlay-title="移动窗口列到上方工作区 / Move column to workspace above" { move-column-to-workspace-up; }

    Mod+Shift+Page_Down hotkey-overlay-title="向下调整工作区顺序 / Move workspace down" { move-workspace-down; }
    Mod+Shift+Page_Up hotkey-overlay-title="向上调整工作区顺序 / Move workspace up" { move-workspace-up; }
    Mod+Shift+U hotkey-overlay-title="向下调整工作区顺序 / Move workspace down" { move-workspace-down; }
    Mod+Shift+I hotkey-overlay-title="向上调整工作区顺序 / Move workspace up" { move-workspace-up; }

    // External mouse wheel switches workspaces; Ctrl moves the focused column.
    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="切换到下方工作区 / Focus workspace below" { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="切换到上方工作区 / Focus workspace above" { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="移动窗口列到下方工作区 / Move column to workspace below" { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="移动窗口列到上方工作区 / Move column to workspace above" { move-column-to-workspace-up; }

    // ============================================================
    // #"截图与取色 / Screenshots and colors"
    // ============================================================
    Mod+Shift+P repeat=false hotkey-overlay-title="拾取屏幕颜色 / Color picker" { spawn "hyprpicker" "-a"; }
    Mod+P repeat=false hotkey-overlay-title="截图：冻结画面后选取区域 / Screenshot frozen region" { spawn "screenshot" "area" "true"; }
    Mod+Ctrl+P repeat=false hotkey-overlay-title="截图：选择窗口 / Screenshot selected window" { spawn "screenshot" "window"; }
    Mod+Alt+P repeat=false hotkey-overlay-title="截图：当前显示器 / Screenshot current display" { spawn "screenshot" "output"; }
    Print repeat=false hotkey-overlay-title="截图：所有显示器 / Screenshot all displays" { spawn "screenshot" "screen"; }

    // ============================================================
    // #"媒体与亮度 / Media and brightness"
    // ============================================================
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="音量增加 5%（最高 100%） / Volume up 5% (max 100%)" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.0"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="音量降低 5% / Volume down 5%" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute repeat=false allow-when-locked=true hotkey-overlay-title="切换扬声器静音 / Toggle speaker mute" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute repeat=false allow-when-locked=true hotkey-overlay-title="切换麦克风静音 / Toggle microphone mute" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay repeat=false allow-when-locked=true hotkey-overlay-title="切换播放与暂停 / Play or pause" { spawn "playerctl" "play-pause"; }
    XF86AudioPause repeat=false allow-when-locked=true hotkey-overlay-title="切换播放与暂停 / Play or pause" { spawn "playerctl" "play-pause"; }
    XF86AudioStop repeat=false allow-when-locked=true hotkey-overlay-title="停止播放 / Stop playback" { spawn "playerctl" "stop"; }
    XF86AudioPrev repeat=false allow-when-locked=true hotkey-overlay-title="播放上一首 / Previous track" { spawn "playerctl" "previous"; }
    XF86AudioNext repeat=false allow-when-locked=true hotkey-overlay-title="播放下一首 / Next track" { spawn "playerctl" "next"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="亮度增加 5% / Brightness up 5%" { spawn "brightnessctl" "--class=backlight" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="亮度降低 5% / Brightness down 5%" { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // ============================================================
    // #"滚动平铺布局 / Scrollable layout"
    // ============================================================
    Mod+O repeat=false hotkey-overlay-title="切换窗口与工作区总览 / Toggle overview" { toggle-overview; }
    Mod+Comma repeat=false hotkey-overlay-title="将右侧窗口并入当前列 / Consume right window into column" { consume-window-into-column; }
    Mod+Period repeat=false hotkey-overlay-title="将列底部窗口移出为独立列 / Expel bottom window from column" { expel-window-from-column; }
    Mod+BracketLeft repeat=false hotkey-overlay-title="向左并入或移出窗口列 / Consume or expel window left" { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false hotkey-overlay-title="向右并入或移出窗口列 / Consume or expel window right" { consume-or-expel-window-right; }

    Mod+R repeat=false hotkey-overlay-title="切换到下一档预设列宽 / Next preset column width" { switch-preset-column-width; }
    Mod+Shift+R repeat=false hotkey-overlay-title="切换到上一档预设列宽 / Previous preset column width" { switch-preset-column-width-back; }
    Mod+Ctrl+R repeat=false hotkey-overlay-title="重置窗口高度 / Reset window height" { reset-window-height; }
    Mod+Minus hotkey-overlay-title="窗口列宽度减少 10% / Decrease column width 10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="窗口列宽度增加 10% / Increase column width 10%" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="窗口高度减少 10% / Decrease window height 10%" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="窗口高度增加 10% / Increase window height 10%" { set-window-height "+10%"; }

    Mod+Home hotkey-overlay-title="切换到首列 / Focus first column" { focus-column-first; }
    Mod+End hotkey-overlay-title="切换到末列 / Focus last column" { focus-column-last; }
    Mod+Ctrl+Home hotkey-overlay-title="移动窗口列到最左侧 / Move column to first" { move-column-to-first; }
    Mod+Ctrl+End hotkey-overlay-title="移动窗口列到最右侧 / Move column to last" { move-column-to-last; }
    Mod+G repeat=false hotkey-overlay-title="将当前窗口列居中 / Center column" { center-column; }
    Mod+Ctrl+G repeat=false hotkey-overlay-title="将可见窗口列居中 / Center visible columns" { center-visible-columns; }
    Mod+Ctrl+F repeat=false hotkey-overlay-title="扩展窗口列以填满可用宽度 / Expand column to available width" { expand-column-to-available-width; }

    // #"快捷键帮助 / Shortcut help"
    Mod+Slash repeat=false hotkey-overlay-title="打开快捷键速查表 / Keybind cheatsheet" {
        spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet";
    }
}
