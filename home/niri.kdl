// Runtime-generated settings stay writable while the main config remains managed by Home Manager.
// Noctalia writes colors to noctalia.kdl; nwg-displays writes outputs to monitor.kdl.
// default.nix pre-creates both files so these includes also work on the first login.
include "noctalia.kdl"
include "monitor.kdl"

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 600
        repeat-rate 25
    }

    // External mouse uses flat acceleration profile, matching Hyprland's global flat profile.
    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    // Touchpad settings reference hyprland.lua's touchpad configuration.
    touchpad {
        tap
        dwt
        natural-scroll
        click-method "clickfinger"
        scroll-method "two-finger"
        accel-profile "adaptive"
        accel-speed 0.0
    }

    // Do not let pointer focus unexpectedly scroll a long horizontal strip.
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    // Keep only the focus ring; its colors are overridden by noctalia.kdl.
    focus-ring {
        width 2
    }
    border {
        off
    }
}

// Match Hyprland's four-pass background blur while keeping colors neutral.
blur {
    passes 4
    offset 3
    noise 0.02
    saturation 1.0
}

// Catppuccin glass effect, corresponding to window_rule in hyprland.lua.
window-rule {
    match app-id=r#"^(kitty|org\.kde\.dolphin)$"#
    opacity 0.90
    background-effect {
        // Reuse the blurred wallpaper for better performance and stability.
        xray true
        blur true
    }
}

spawn-at-startup "fcitx5" "-d" "--replace"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

environment {
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XMODIFIERS "@im=fcitx"
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "32"
}

binds {
    // ============================================================
    // Window and session operations
    // ============================================================
    Mod+Q repeat=false  { close-window; }
    Alt+F4 repeat=false { close-window; }
    Mod+W repeat=false  { toggle-window-floating; }
    Mod+Shift+V repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+Shift+F repeat=false { fullscreen-window; }
    Mod+F repeat=false       { maximize-column; }
    Mod+M repeat=false       { maximize-window-to-edges; }
    Mod+Backslash repeat=false { toggle-column-tabbed-display; }

    // Keep the lock shortcut available even if a previous locker crashed, and
    // do not allow shortcut-inhibiting clients to swallow it.
    Mod+Alt+L repeat=false allow-when-locked=true allow-inhibiting=false {
        spawn "hyprlock";
    }

    // Native niri recent-windows owns Alt+Tab. Super+Tab remains a quick
    // workspace back-and-forth shortcut.
    Mod+Tab repeat=false { focus-workspace-previous; }

    // Escape hatch for remote desktop, games, and other shortcut inhibitors.
    Mod+Escape repeat=false allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E repeat=false { quit; }

    // ============================================================
    // Focus movement (arrows and Vim-style home-row keys)
    // ============================================================
    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }
    Mod+H       { focus-column-left; }
    Mod+L       { focus-column-right; }
    Mod+K       { focus-window-up; }
    Mod+J       { focus-window-down; }

    // ============================================================
    // Move the focused column/window inside the current workspace
    // ============================================================
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    // ============================================================
    // Focus monitors and move the focused column between monitors
    // ============================================================
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+J     { focus-monitor-down; }

    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+H     { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L     { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+K     { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+J     { move-column-to-monitor-down; }

    // ============================================================
    // Common applications
    // ============================================================
    Mod+T repeat=false hotkey-overlay-title="Open Kitty" { spawn "kitty"; }
    Mod+E repeat=false hotkey-overlay-title="Open Dolphin" { spawn "dolphin"; }
    Mod+C repeat=false hotkey-overlay-title="Open Visual Studio Code" { spawn "code"; }
    Mod+B repeat=false hotkey-overlay-title="Open Firefox" { spawn "firefox"; }
    Ctrl+Shift+Escape repeat=false hotkey-overlay-title="Open Mission Center" {
        spawn "missioncenter";
    }
    Mod+A repeat=false hotkey-overlay-title="Open Application Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }
    Mod+V repeat=false hotkey-overlay-title="Open Clipboard History" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard";
    }

    // ============================================================
    // Dynamic workspaces (vertical, relative navigation)
    // ============================================================
    // Numeric indices are best-effort in niri's dynamic workspace model: an
    // index past the current workspace count selects the trailing empty one.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 repeat=false { move-column-to-workspace 1; }
    Mod+Shift+2 repeat=false { move-column-to-workspace 2; }
    Mod+Shift+3 repeat=false { move-column-to-workspace 3; }
    Mod+Shift+4 repeat=false { move-column-to-workspace 4; }
    Mod+Shift+5 repeat=false { move-column-to-workspace 5; }
    Mod+Shift+6 repeat=false { move-column-to-workspace 6; }
    Mod+Shift+7 repeat=false { move-column-to-workspace 7; }
    Mod+Shift+8 repeat=false { move-column-to-workspace 8; }
    Mod+Shift+9 repeat=false { move-column-to-workspace 9; }
    Mod+Shift+0 repeat=false { move-column-to-workspace 10; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // External mouse wheel switches workspaces; Ctrl moves the focused column.
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // ============================================================
    // Screen capture (shared with Hyprland; Satty opens after capture)
    // ============================================================
    Mod+Shift+P repeat=false { spawn "hyprpicker" "-a"; }
    Mod+P repeat=false      { spawn "hypr-screenshot" "area"; }
    Mod+Ctrl+P repeat=false { spawn "hypr-screenshot" "area" "true"; }
    Mod+Alt+P repeat=false  { spawn "hypr-screenshot" "output"; }
    Print repeat=false      { spawn "hypr-screenshot" "screen"; }

    // ============================================================
    // Media and brightness (volume/brightness intentionally repeat on hold)
    // ============================================================
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay repeat=false allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause repeat=false allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop repeat=false allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev repeat=false allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext repeat=false allow-when-locked=true { spawn "playerctl" "next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // ============================================================
    // Scrollable-layout operations
    // ============================================================
    Mod+O repeat=false { toggle-overview; }
    Mod+Comma repeat=false       { consume-window-into-column; }
    Mod+Period repeat=false      { expel-window-from-column; }
    Mod+BracketLeft repeat=false { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false { consume-or-expel-window-right; }

    Mod+R repeat=false       { switch-preset-column-width; }
    Mod+Shift+R repeat=false { switch-preset-column-width-back; }
    Mod+Ctrl+R repeat=false  { reset-window-height; }
    Mod+Minus          { set-column-width "-10%"; }
    Mod+Equal          { set-column-width "+10%"; }
    Mod+Shift+Minus    { set-window-height "-10%"; }
    Mod+Shift+Equal    { set-window-height "+10%"; }

    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }
    Mod+G repeat=false      { center-column; }
    Mod+Ctrl+G repeat=false { center-visible-columns; }
    Mod+Ctrl+F repeat=false { expand-column-to-available-width; }

    Mod+Shift+Slash repeat=false { show-hotkey-overlay; }
}
